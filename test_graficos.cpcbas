10 MODE 1
20 BORDER 13
30 PAPER 0
40 PEN 1
50 CLS
60 INK 0, 1
70 INK 1, 24
80 INK 2, 6
90 INK 3, 18
100 PRINT "--- DEMOSTRACION GRAFICA Y COLOR ---"
110 PRINT "Dibujando lineas diagonales..."
120 MOVE 0, 0
130 PEN 1
140 DRAW 640, 400
150 MOVE 0, 400
160 PEN 2
170 DRAW 640, 0
180 PEN 3
190 LOCATE 1, 5
200 PRINT "Puntos aleatorios (PLOT)..."
210 FOR I = 1 TO 200
220 X = INT(RND(1) * 640)
230 Y = INT(RND(1) * 400)
240 C = INT(RND(1) * 3) + 1
250 PLOT X, Y, C
260 NEXT I
270 LOCATE 1, 24
280 INPUT "Pulsa INTRO para salir...", A$
290 STOP
