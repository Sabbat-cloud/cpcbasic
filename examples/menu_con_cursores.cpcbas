10 REM SELECCION DE MENUS POR CURSORES
20 MODE 1
30 LOCATE 15,5: PRINT "M E N U"
40 LOCATE 14,16: PRINT "---------"
50 READ M: FOR K=1 TO M
60 READ T$
70 LOCATE 12,8+K*2: PRINT K;" - ";T$
80 NEXT K
90 FIL=10
100 IF FIL>M*2+8 THEN FIL=10
110 IF FIL<10 THEN FIL=M*2+8
120 LOCATE 11,FIL: PRINT ">"
130 IF INKEY(18)<>-1 OR INKEY(6)<>-1 THEN 200
140 IF INKEY(0)<>-1 THEN 170
150 IF INKEY(2)<>-1 THEN 180
160 GOTO 130
170 LOCATE 11,FIL: PRINT " ": FIL=FIL-2
175 IF INKEY(0)<>-1 THEN 175
176 GOTO 100
180 LOCATE 11,FIL: PRINT " ": FIL=FIL+2
185 IF INKEY(2)<>-1 THEN 185
186 GOTO 100
200 REM DIRECCIONAMIENTO A LAS SUBRUTINAS
210 X = FIL/2-4
220 LOCATE 10,20: PRINT "ELEGIDA OPCION "; X
225 IF INKEY(18)<>-1 OR INKEY(6)<>-1 THEN 225
230 ON X GOTO 1000, 2000, 3000, 4000
300 DATA 4,LONGITUDES,SUPERFICIES,VOLUMENES,F I N
1000 REM RUTINA LONGITUD
1010 END
2000 REM RUTINA DE SUPERFICIES
2010 END
3000 REM RUTINA DE VOLUMENES
3010 END
4000 REM RUTINA FIN DE PROGRAMA
4010 END
