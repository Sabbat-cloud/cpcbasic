10 REM PROGRAMA FICHER02D
20 REM Programa para almacenar datos coordenadas para dibujarlos con DRAV2D
25 CLS
30 INPUT"NOMBRE DEL FICHERO";h$
40 OPENOUT h$
50 INPUT "NUMERO DE PUNTOS";npts
55 WRITE #9,npts
60 PRINT "INTRODUZCA LOS PARES X,Y"
70 FOR i=1 TO npts
80 INPUT"X=";x:INPUT"Y=";y
90 WRITE #9,x
100 WRITE #9,y
110 NEXT i
120 INPUT "NUMERO DE LINEAS";lI
130 WRITE #9,LI
140 PRINT "NUMERO DE PUNTOS DE UNION"
150 FOR I=1 TO li
160 INPUT "COMIENZO DESDE EL NUM";sn:INPUT "HASTA EL NUM";fi
170 WRITE #9,sn
180 WRITE #9,fi
190 NEXT i
200 REM AMPLIACIONES DE FICHERO 2D
210 INPUT "SEGMENTOS";SN
220 PRINT #9,SN
230 PRINT "LECTURA DE LA MATRIZ DE DATOS S"
240 FOR I = 1 TO SN
250 INPUT J,K,L
260 PRINT #9,J:PRINT #9,K:PRINT #9,L
270 NEXT I
280 CLOSEOUT:END
