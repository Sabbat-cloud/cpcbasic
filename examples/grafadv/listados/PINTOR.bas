140 FOR y=350 TO 250 STEP -1
150 MOVE 150,y
160 DRAW 350,y
170 NEXT y
180 REM Rectangulo amarillo
190 GRAPHICS PEN 3
200 FOR y=250 TO 150 STEP -1
210 MOVE 200,y
220 DRAW 400,y
230 NEXT y
240 REM Rectangulo verde
250 GRAPHICS PEN 4
260 FOR y=380 TO 200 STEP -1
270 MOVE 230,y
280 DRAW 500,y
290 NEXT y
299 |copy
300 END
