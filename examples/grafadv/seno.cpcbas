10 REM PROGRMA SENO
20 MODE 1: CLS: DEG
30 INK 0,13: INK 1,0
40 INPUT "VALOR MAXIMO DE LA Y (Prueba: 400)"; YV
45 M=YV/2
50 INPUT "ALT, ANCHO, PROF (Prueba: 50, 2, 0)"; H,W,D
60 IF H>M THEN 40
70 INPUT "MIN(X), MAX(X) (Prueba: 0, 640)"; XMIN, XMAX
80 YA = M - (H*SIN(W*XMIN+D))
90 MOVE XMIN, YA
100 FOR XB = XMIN TO XMAX
110   YB = M - (H*SIN(W*XB+D))
120   DRAW XB, YB
130 NEXT XB
140 END

