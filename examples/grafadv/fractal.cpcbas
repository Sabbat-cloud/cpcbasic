10 REM FRACTAL
20 REM MUESTRA COMO PUNTEAR PARA GENERAR FIGURAS ABSTRACTAS
21 REM EJEMPLOS:
22 REM ESPRIRALES Y REMOLINOS LAMBDA (LX,LY)1.5, 1.5  ESCALA 3.5
23 REM POLVO DE CANTOR (LX,LY) 3.2,0.5 ESCALA 3.5
24 REM CLASICO (LX,LY)2,0  ESCALA 3
25 REM ESTRUCTURAS ASIMETRICAS Y EXOTICAS (LX,LY)-1,1  ESCALA 2 O 3
26 REM VALORES LIMITE (LX,LY)2.5, 1.2  ESCALA 3
30 RANDOMIZE
40 MODE 1
50 INK 0,0:INK 1,24
60 CX=320:CY=200
70 X=0.50001:Y=0
80 GOSUB 390
90 FOR I=1 TO 10:GOSUB 310:NEXT I
100 GOSUB 460
110 GOSUB 310
120 GOTO 100
130 END
140 REM RAIZ CUADRADA DE X Y
150 T=Y
160 S=SQR(ABS(X*X+Y*Y))
170 Y=SQR(ABS((-X+S)/2))
180 X=SQR(ABS((X+S)/2))
190 IF T<0 THEN X=-X
200 RETURN
210 REM CUATRO POR L
220 S=LX*LX+LY*LY
230 LX=4*LX/S
240 LY=-4*LY/S
250 RETURN
260 REM X Y VECES L
270 TX=X:TY=Y
280 X=TX*LX-TY*LY
290 Y=TX*LY+TY*LX
300 RETURN
310 REM FUNCION DE X Y
320 GOSUB 260
330 X=1-X
340 GOSUB 140
350 IF RND(1)<=0.5 THEN X=-X:Y=-Y
360 X=1-X
370 X=X/2:Y=Y/2
380 RETURN
390 REM ENTRADA DE VALORES
400 INPUT "VALOE DE LAMBDA";LX,LY
410 GOSUB 210
420 INPUT"VALOR DE ESCALA";SC
430 SC=2*CX/SC
440 CLS
450 RETURN
460 REM DIBUJA X Y
470 PLOT SC*(X-0.5)+CX,CY-SC*Y
480 RETURN

