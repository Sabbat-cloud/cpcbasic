20 CLS
30 T$="TEXTO RECUADRADO":COL=5:FIL=6:GOSUB 9000
40 T$=" M E N U ":COL=25:FIL=16:GOSUB 9000
50 END
9000 REM RECUADRAR TEXTOS
9010 IF COL + LEN(T$)> 40 THEN PRINT "TEXTO EXCESIVAMENTE LARGO": GOTO 9100
9030 LOCATE COL,FIL:PRINT T$
9040 F = 25-FIL + 1:C = COL-2
9050 PLOT C*16, F*16 + 5
9060 DRAWR (LEN(T$)+ 2)*16,0
9070 DRAWR 0,-24
9080 DRAWR -(LEN(T$)+ 2)*16,0
9090 DRAWR 0,24
9100 RETURN

