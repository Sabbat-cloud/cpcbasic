1 GOSUB 1000:GOTO 100
10 I$=INKEY$:OX=JX:OY=JY
11 IF INKEY(8)=0 THEN JX=JX-1
12 IF INKEY(1)=0 THEN JX=JX+1
13 IF INKEY(0)=0 THEN JY=JY-1
14 IF INKEY(2)=0 THEN JY=JY+1
15 IF JX=9 AND JY=2 AND LLAVEENCONTRADA=1 AND TUMBAENCONTRADA=1 THEN GOTO 90
16 IF JX<1 OR JX>21 OR JY<3 OR JY>19 THEN JX=OX:JY=OY
17 CX=(JX-1) AND 3:CY=(JY-3) AND 3:IF CX>0 AND CY>0 THEN JX=OX:JY=OY
18 IF JX=OX AND JY=OY THEN GOTO 23
19 LOCATE OX,OY:PEN 1:IF ((OX-1) AND 3)=0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
20 BORDES(JX,JY)=1:LOCATE JX,JY:PEN 3:PRINT CHR$(250)
21 SOUND 2,100,2,10:GOSUB 40
23 MOMIAASESINA=0:FOR M=1 TO NUMMOMIAS
24 IF RND*10>(3+NIVEL) THEN GOTO 35
25 OMX(M)=MX(M):OMY(M)=MY(M):CMX=(MX(M)-1) AND 3:CMY=(MY(M)-3) AND 3
26 IF CMX<>0 OR CMY<>0 THEN GOTO 29
27 DX=JX-MX(M):DY=JY-MY(M)
28 IF ABS(DX)>ABS(DY) AND DX<>0 THEN MX(M)=MX(M)+SGN(DX):GOTO 31 ELSE IF DY<>0 THEN MY(M)=MY(M)+SGN(DY):GOTO 31 ELSE IF DX<>0 THEN MX(M)=MX(M)+SGN(DX):GOTO 31 ELSE GOTO 31
29 IF CMX=0 THEN IF JY>MY(M) THEN MY(M)=MY(M)+1 ELSE IF JY<MY(M) THEN MY(M)=MY(M)-1
30 IF CMX<>0 THEN IF JX>MX(M) THEN MX(M)=MX(M)+1 ELSE IF JX<MX(M) THEN MX(M)=MX(M)-1
31 IF MX(M)<1 OR MX(M)>21 OR MY(M)<3 OR MY(M)>19 THEN MX(M)=OMX(M):MY(M)=OMY(M)
32 IF MX(M)=OMX(M) AND MY(M)=OMY(M) THEN GOTO 35
33 LOCATE OMX(M),OMY(M):PEN 1:IF BORDES(OMX(M),OMY(M))=0 THEN PRINT " ":GOTO 34 ELSE IF ((OMX(M)-1) AND 3)=0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
34 LOCATE MX(M),MY(M):PEN 2:PRINT CHR$(251)
35 IF MX(M)=JX AND MY(M)=JY THEN MOMIAASESINA=M
36 NEXT M
37 IF MOMIAASESINA>0 THEN GOTO 75
38 GOTO 10
40 T1=INT((JX-1)/4):C1=T1:IF (JX-1) AND 3 THEN C1=C1+1
41 C2=T1+1:IF C1<1 THEN C1=1
42 IF C2>5 THEN C2=5
43 T2=INT((JY-3)/4):F1=T2:IF (JY-3) AND 3 THEN F1=F1+1
44 F2=T2+1:IF F1<1 THEN F1=1
45 IF F2>4 THEN F2=4
46 FOR C=C1 TO C2:FOR F=F1 TO F2
47 IF SALAESTADO(C,F)=1 THEN GOTO 62
48 X=(C-1)*4+1:Y=(F-1)*4+3:CERRADO=1:K=0
49 WHILE K<=4 AND CERRADO=1
50 IF BORDES(X+K,Y)=0 THEN CERRADO=0:GOTO 52 ELSE IF BORDES(X+K,Y+4)=0 THEN CERRADO=0:GOTO 52 ELSE IF BORDES(X,Y+K)=0 THEN CERRADO=0:GOTO 52 ELSE IF BORDES(X+4,Y+K)=0 THEN CERRADO=0:GOTO 52
51 K=K+1:WEND
52 IF CERRADO=0 THEN GOTO 62
53 SALAESTADO(C,F)=1:PUNTOS=PUNTOS+50:LOCATE 1,1:PEN 2:PRINT "NIVEL:";NIVEL;"  PUNTOS:";PUNTOS;"  VIDAS:";VIDAS
54 FOR DY=1 TO 3:LOCATE X+1,Y+DY:PRINT "   ":NEXT DY
55 LOCATE X+2,Y+2:PEN 2:OBJ=SALA(C,F)
56 IF OBJ=1 THEN PRINT CHR$(254):LLAVEENCONTRADA=1
57 IF OBJ=2 THEN PRINT CHR$(255):TUMBAENCONTRADA=1
58 IF OBJ=3 THEN PRINT CHR$(249):PODER=1
59 IF OBJ=4 AND NUMMOMIAS<5 THEN NUMMOMIAS=NUMMOMIAS+1:MX(NUMMOMIAS)=X+2:MY(NUMMOMIAS)=Y+2:OMX(NUMMOMIAS)=X+2:OMY(NUMMOMIAS)=Y+2:PRINT CHR$(251)
60 IF OBJ=5 THEN PRINT CHR$(248):PUNTOS=PUNTOS+100:LOCATE 1,1:PEN 2:PRINT "NIVEL:";NIVEL;"  PUNTOS:";PUNTOS;"  VIDAS:";VIDAS
61 SOUND 4,200,20,15
62 NEXT F:NEXT C:RETURN
75 IF PODER=1 THEN PUNTOS=PUNTOS+100:SOUND 4,150,10,15:PODER=0:GOTO 78
76 SOUND 1,800,40,15:SOUND 2,900,40,15:VIDAS=VIDAS-1:IF VIDAS=0 THEN LOCATE 1,20:PRINT "GAME OVER":END
77 GOTO 78
78 LOCATE 1,1:PEN 2:PRINT "NIVEL:";NIVEL;"  PUNTOS:";PUNTOS;"  VIDAS:";VIDAS
79 FOR I=MOMIAASESINA TO NUMMOMIAS-1:MX(I)=MX(I+1):MY(I)=MY(I+1):OMX(I)=OMX(I+1):OMY(I)=OMY(I+1):NEXT I
80 NUMMOMIAS=NUMMOMIAS-1:LOCATE JX,JY:PEN 3:PRINT CHR$(250):GOTO 10
90 LOCATE 1,20:PRINT "NIVEL COMPLETADO!":SOUND 2,100,50,15:SOUND 4,150,50,15
91 FOR P=1 TO 500:NEXT P:NIVEL=NIVEL+1:GOTO 100
100 CLS:LOCATE 1,1:PEN 2:PRINT "NIVEL:";NIVEL;"  PUNTOS:";PUNTOS;"  VIDAS:";VIDAS
101 NUMMOMIAS=1+INT((NIVEL-1)/2):IF NUMMOMIAS>5 THEN NUMMOMIAS=5
102 FOR F=1 TO 4:FOR C=1 TO 5:SALA(C,F)=0:SALAESTADO(C,F)=0:NEXT C,F
103 FOR X=1 TO 22:FOR Y=1 TO 20:BORDES(X,Y)=0:NEXT Y,X
104 FOR I=1 TO 6:BOLSA(I)=5:NEXT I:BOLSA(7)=1:BOLSA(8)=2:BOLSA(9)=3:BOLSA(10)=4:FOR I=11 TO 20:BOLSA(I)=0:NEXT I
105 FOR I=1 TO 20:R=INT(RND*20)+1:SW=BOLSA(I):BOLSA(I)=BOLSA(R):BOLSA(R)=SW:NEXT I
106 I=1:FOR F=1 TO 4:FOR C=1 TO 5:SALA(C,F)=BOLSA(I):I=I+1:NEXT C,F
107 LOCATE 8,2:PEN 1:PRINT CHR$(143):LOCATE 10,2:PRINT CHR$(143)
108 FOR F=1 TO 4:FOR C=1 TO 5:X=(C-1)*4+2:Y=(F-1)*4+4
109 LOCATE X,Y:PEN 1:PRINT CHR$(143);CHR$(143);CHR$(143)
110 LOCATE X,Y+1:PRINT CHR$(143);CHR$(143);CHR$(143)
111 LOCATE X,Y+2:PRINT CHR$(143);CHR$(143);CHR$(143):NEXT C,F
112 JX=1:JY=3:BORDES(JX,JY)=1:LOCATE JX,JY:PEN 3:PRINT CHR$(250)
113 FOR M=1 TO NUMMOMIAS:MX(M)=21:MY(M)=19:OMX(M)=21:OMY(M)=19:LOCATE 21,19:PEN 2:PRINT CHR$(251):NEXT M
114 LLAVEENCONTRADA=0:TUMBAENCONTRADA=0:PODER=0:GOTO 10
1000 MODE 1:BORDER 0:INK 0,0:INK 1,24:INK 2,6:INK 3,26
1001 DEFINT A-Z:RANDOMIZE TIME:ENV 1,15,-1,10:ENT 1,15,-1,2
1002 SYMBOL 250,24,24,60,126,255,60,102,102:SYMBOL 251,60,126,255,255,255,126,60,60
1003 SYMBOL 252,24,24,24,24,24,24,24,24:SYMBOL 253,0,0,0,255,255,0,0,0
1004 SYMBOL 254,0,60,126,255,255,126,60,0:SYMBOL 255,126,255,219,219,255,255,255,126
1005 SYMBOL 249,60,126,219,219,126,60,60,60:SYMBOL 248,0,126,255,219,255,126,0,0
1006 DIM SALA(5,4),BORDES(22,20),SALAESTADO(5,4),MX(5),MY(5),OMX(5),OMY(5),BOLSA(20)
1007 NIVEL=1:VIDAS=6:PUNTOS=0:RETURN
