10 ' OH MUMMY V2 - GRAFICOS MEJORADOS (PEEK, POKE Y BANCO MEMORIA)
20 ' --------------------------------------------------------
30 MODE 1: BORDER 0: INK 0,0: INK 1,24: INK 2,6: INK 3,26
40 DEFINT A-Z: RANDOMIZE TIME
50 ' INICIALIZAR LA COLA DE SONIDO PARA LA MUSICA DE FONDO
60 ENV 1, 15, -1, 10
70 ENT 1, 15, -1, 2
80 ON SQ(1) GOSUB 2000
85 GOSUB 3000 ' Cargar graficos en banco de memoria extra
90 ' DEFINIR CARACTERES (AUN USAMOS SYMBOL PARA FONDOS)
120 SYMBOL 252, 24, 24, 24, 24, 24, 24, 24, 24 ' HUELLA VERTICAL
130 SYMBOL 253, 0, 0, 0, 255, 255, 0, 0, 0 ' HUELLA HORIZONTAL
140 SYMBOL 254, 0, 60, 126, 255, 255, 126, 60, 0 ' LLAVE
150 SYMBOL 255, 126, 255, 219, 219, 255, 255, 255, 126 ' TUMBA
160 SYMBOL 249, 60, 126, 219, 219, 126, 60, 60, 60 ' PERGAMINO
165 SYMBOL 248, 0, 126, 255, 219, 255, 126, 0, 0 ' COFRE/TESORO
170 ' INICIALIZAR VARIABLES DE JUEGO Y ARRAYS
172 DIM SALA(5,4), BORDES(22,20), SALAESTADO(5,4)
174 DIM MX(5), MY(5), OMX(5), OMY(5), BOLSA(20)
180 NIVEL = 1: VIDAS = 6: PUNTOS = 0
190 ' BUCLE DE INICIO DE NIVEL
200 CLS: LOCATE 1,1: PEN 2: PRINT "NIVEL:";NIVEL; "  PUNTOS:";PUNTOS; "  VIDAS:";VIDAS
205 NUM_MOMIAS = 1 + INT((NIVEL-1)/2)
206 IF NUM_MOMIAS > 5 THEN NUM_MOMIAS = 5
220 FOR F=1 TO 4: FOR C=1 TO 5: SALA(C,F)=0: SALAESTADO(C,F)=0: NEXT C,F
230 FOR X=1 TO 22: FOR Y=1 TO 20: BORDES(X,Y)=0: NEXT Y,X
240 ' ASIGNAR OBJETOS FIJOS
245 FOR I=1 TO 6: BOLSA(I)=5: NEXT I
250 BOLSA(7)=1: BOLSA(8)=2: BOLSA(9)=3: BOLSA(10)=4
260 FOR I=11 TO 20: BOLSA(I)=0: NEXT I
270 FOR I=1 TO 20: R=INT(RND*20)+1: SW=BOLSA(I): BOLSA(I)=BOLSA(R): BOLSA(R)=SW: NEXT I
280 I=1: FOR F=1 TO 4: FOR C=1 TO 5: SALA(C,F)=BOLSA(I): I=I+1: NEXT C,F
290 ' DIBUJAR PANTALLA
295 LOCATE 8,2: PEN 1: PRINT CHR$(143)
296 LOCATE 10,2: PEN 1: PRINT CHR$(143)
300 FOR F=1 TO 4
310   FOR C=1 TO 5
320     X = (C-1)*4 + 2: Y = (F-1)*4 + 4
330     LOCATE X,Y: PEN 1: PRINT CHR$(143);CHR$(143);CHR$(143)
340     LOCATE X,Y+1: PEN 1: PRINT CHR$(143);CHR$(143);CHR$(143)
350     LOCATE X,Y+2: PEN 1: PRINT CHR$(143);CHR$(143);CHR$(143)
360   NEXT C
370 NEXT F
380 ' POSICION INICIAL DEL JUGADOR Y MOMIAS
390 JX = 1: JY = 3: BORDES(JX,JY) = 1
400 TIPO_SPRITE = 1: SPRITE_X = JX: SPRITE_Y = JY: GOSUB 4000 ' DIBUJAR JUGADOR CON POKE
410 FOR M=1 TO NUM_MOMIAS
420   MX(M) = 21: MY(M) = 19
430   OMX(M) = MX(M): OMY(M) = MY(M)
435   TIPO_SPRITE = 2: SPRITE_X = MX(M): SPRITE_Y = MY(M): GOSUB 4000 ' DIBUJAR MOMIA
440 NEXT M
445 LLAVE_ENCONTRADA = 0: TUMBA_ENCONTRADA = 0: PODER = 0
450 ' DISPARAR MUSICA INICIAL
455 SQ(1)
460 ' BUCLE PRINCIPAL
465 I$ = INKEY$
470 OX = JX: OY = JY
480 IF INKEY(8) = 0 THEN JX=JX-1
490 IF INKEY(1) = 0 THEN JX=JX+1
500 IF INKEY(0) = 0 THEN JY=JY-1
510 IF INKEY(2) = 0 THEN JY=JY+1
520 ' COMPROBAR LIMITES Y SALIDA
525 IF JX=9 AND JY=2 AND LLAVE_ENCONTRADA=1 AND TUMBA_ENCONTRADA=1 THEN GOTO 1500
530 IF JX<1 OR JX>21 OR JY<3 OR JY>19 THEN JX=OX: JY=OY
540 ' COMPROBAR CAMINOS
550 CX = (JX-1) MOD 4: CY = (JY-3) MOD 4
560 IF CX > 0 AND CY > 0 THEN JX=OX: JY=OY
570 ' MOVER JUGADOR
580 IF JX=OX AND JY=OY THEN GOTO 660
590 LOCATE OX,OY: PEN 1
600 IF (OX-1) MOD 4 = 0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
610 BORDES(JX,JY) = 1
620 TIPO_SPRITE = 1: SPRITE_X = JX: SPRITE_Y = JY: GOSUB 4000
630 SOUND 2,100,2,10
640 GOSUB 1000
660 ' IA DE MOMIAS
664 MOMIA_ASESINA = 0
665 FOR M=1 TO NUM_MOMIAS
670   IF RND * 10 > (3 + NIVEL) THEN GOTO 870
680   OMX(M) = MX(M): OMY(M) = MY(M)
690   CMX = (MX(M)-1) MOD 4: CMY = (MY(M)-3) MOD 4
700   IF CMX <> 0 OR CMY <> 0 THEN GOTO 800
710   ' INTERSECCION
720   DX = JX - MX(M): DY = JY - MY(M)
730   IF ABS(DX) > ABS(DY) AND DX <> 0 THEN MX(M) = MX(M) + SGN(DX): GOTO 850
740   IF DY <> 0 THEN MY(M) = MY(M) + SGN(DY): GOTO 850
750   IF DX <> 0 THEN MX(M) = MX(M) + SGN(DX)
760   GOTO 850
800   ' PASILLO Y RECUADROS INTERIORES
810   IF CMX = 0 THEN IF JY > MY(M) THEN MY(M) = MY(M) + 1 ELSE IF JY < MY(M) THEN MY(M) = MY(M) - 1
820   IF CMX <> 0 THEN IF JX > MX(M) THEN MX(M) = MX(M) + 1 ELSE IF JX < MX(M) THEN MX(M) = MX(M) - 1
850   IF MX(M)<1 OR MX(M)>21 OR MY(M)<3 OR MY(M)>19 THEN MX(M)=OMX(M): MY(M)=OMY(M)
870   ' DIBUJAR MOMIA
875   IF MX(M)=OMX(M) AND MY(M)=OMY(M) THEN GOTO 920
880   LOCATE OMX(M),OMY(M): PEN 1
890   IF BORDES(OMX(M),OMY(M))=0 THEN PRINT " ": GOTO 910
900   IF (OMX(M)-1) MOD 4 = 0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
910   TIPO_SPRITE = 2: SPRITE_X = MX(M): SPRITE_Y = MY(M): GOSUB 4000
920   ' COLISION
930   IF MX(M)=JX AND MY(M)=JY THEN MOMIA_ASESINA = M
935 NEXT M
936 IF MOMIA_ASESINA > 0 THEN GOTO 1300
940 FOR RETARDO=1 TO 20: NEXT RETARDO
960 GOTO 460
970 ' -----------------------------------------
980 ' RUTINA RECUADROS
1000 C1 = INT((JX-1)/4): IF (JX-1) MOD 4 <> 0 THEN C1 = C1 + 1
1010 C2 = INT((JX-1)/4) + 1
1020 IF C1 < 1 THEN C1 = 1
1030 IF C2 > 5 THEN C2 = 5
1040 F1 = INT((JY-3)/4): IF (JY-3) MOD 4 <> 0 THEN F1 = F1 + 1
1050 F2 = INT((JY-3)/4) + 1
1060 IF F1 < 1 THEN F1 = 1
1070 IF F2 > 4 THEN F2 = 4
1080 FOR C = C1 TO C2
1090   FOR F = F1 TO F2
1100     IF SALAESTADO(C,F) = 1 THEN GOTO 1260
1110     X = (C-1)*4 + 1: Y = (F-1)*4 + 3
1120     CERRADO = 1: K = 0
1130     WHILE K <= 4 AND CERRADO = 1
1140       IF BORDES(X+K,Y)=0 THEN CERRADO=0
1150       IF BORDES(X+K,Y+4)=0 THEN CERRADO=0
1160       IF BORDES(X,Y+K)=0 THEN CERRADO=0
1170       IF BORDES(X+4,Y+K)=0 THEN CERRADO=0
1180       K = K + 1
1190     WEND
1200     IF CERRADO = 0 THEN GOTO 1260
1210     SALAESTADO(C,F) = 1: PUNTOS = PUNTOS + 50
1220     LOCATE 1,1: PEN 2: PRINT "NIVEL:";NIVEL; "  PUNTOS:";PUNTOS; "  VIDAS:";VIDAS
1230     FOR DY=1 TO 3: LOCATE X+1, Y+DY: PRINT "   ": NEXT DY
1240     LOCATE X+2, Y+2: PEN 2: OBJ = SALA(C,F)
1250     IF OBJ = 1 THEN PRINT CHR$(254): LLAVE_ENCONTRADA=1
1252     IF OBJ = 2 THEN PRINT CHR$(255): TUMBA_ENCONTRADA=1
1254     IF OBJ = 3 THEN PRINT CHR$(249): PODER=1
1256     IF OBJ = 4 AND NUM_MOMIAS < 5 THEN NUM_MOMIAS = NUM_MOMIAS + 1: MX(NUM_MOMIAS)=X+2: MY(NUM_MOMIAS)=Y+2: OMX(NUM_MOMIAS)=X+2: OMY(NUM_MOMIAS)=Y+2: TIPO_SPRITE=2: SPRITE_X=MX(NUM_MOMIAS): SPRITE_Y=MY(NUM_MOMIAS): GOSUB 4000
1257     IF OBJ = 5 THEN PRINT CHR$(248): PUNTOS = PUNTOS + 100: LOCATE 1,1: PEN 2: PRINT "NIVEL:";NIVEL; "  PUNTOS:";PUNTOS; "  VIDAS:";VIDAS
1258     SOUND 4, 200, 20, 15
1260   NEXT F
1270 NEXT C
1290 RETURN
1300 ' COLISION
1320 IF PODER = 1 THEN GOTO 1400
1330 SOUND 1, 800, 40, 15: SOUND 2, 900, 40, 15
1340 VIDAS = VIDAS - 1: IF VIDAS=0 THEN LOCATE 1,20: PRINT "GAME OVER": END
1350 GOTO 1420
1400 PUNTOS = PUNTOS + 100: SOUND 4, 150, 10, 15: PODER = 0
1420 LOCATE 1,1: PEN 2: PRINT "NIVEL:";NIVEL; "  PUNTOS:";PUNTOS; "  VIDAS:";VIDAS
1430 FOR I = MOMIA_ASESINA TO NUM_MOMIAS - 1
1440   MX(I) = MX(I+1): MY(I) = MY(I+1): OMX(I) = OMX(I+1): OMY(I) = OMY(I+1)
1450 NEXT I
1460 NUM_MOMIAS = NUM_MOMIAS - 1
1470 TIPO_SPRITE=1: SPRITE_X=JX: SPRITE_Y=JY: GOSUB 4000
1480 GOTO 460
1500 ' PASA DE NIVEL
1520 LOCATE 1,20: PRINT "NIVEL COMPLETADO!"
1530 SOUND 2, 100, 50, 15: SOUND 4, 150, 50, 15
1540 FOR P=1 TO 500: NEXT P
1550 NIVEL = NIVEL + 1: GOTO 190
2000 ' MUSICA
2010 READ P, D, V: IF P = -1 THEN RESTORE 2100: READ P, D, V
2030 SOUND 1, P, D, V, 1, 1: RETURN
2100 DATA 319,15,10, 319,15,10, 338,10,10, 319,30,10, 0,10,0
2120 DATA 319,15,10, 338,15,10, 402,15,10, 426,30,10, 0,10,0
2140 DATA 402,15,10, 358,15,10, 402,15,10, 426,30,10, 0,10,0
2160 DATA 478,15,10, 506,15,10, 478,30,10, 0,20,0, -1,-1,-1
3000 ' --- INICIALIZAR GRAFICOS EN BANCO DE MEMORIA EXTRA ---
3010 OUT &7FFF, &C4 ' Cambiamos al banco RAM extra (expansión de memoria)
3020 RESTORE 3100
3030 ' POKEamos sprite del Jugador (8 bytes) en &4000
3040 FOR I = 0 TO 7: READ D: POKE &4000 + I, D: NEXT I
3050 ' POKEamos sprite de la Momia (8 bytes) en &4008
3060 FOR I = 0 TO 7: READ D: POKE &4008 + I, D: NEXT I
3070 OUT &7FFF, &C0 ' Volvemos al banco normal
3080 RETURN
3100 DATA 24, 24, 60, 126, 255, 60, 102, 102 ' JUGADOR MEJORADO
3110 DATA 60, 126, 255, 255, 255, 126, 60, 60 ' MOMIA MEJORADA
4000 ' --- DIBUJAR SPRITE LEYENDO DESDE BANCO CON PEEK ---
4010 OUT &7FFF, &C4 ' Acceder al banco de graficos
4020 DIR_BASE = &4000: IF TIPO_SPRITE = 2 THEN DIR_BASE = &4008
4030 FOR LINEA = 0 TO 7
4040   VALOR = PEEK(DIR_BASE + LINEA)
4050   ' POKE a la memoria de video &C000 simulada (o usamos LOCATE+PRINT como fallback compatible)
4060   ' Como es CPC Basic, podemos redefinir el simbolo dinamicamente o dibujarlo:
4070   POKE &A700 + LINEA, VALOR ' Opcional: escribir en la memoria de simbolos!
4080 NEXT LINEA
4090 OUT &7FFF, &C0 ' Volver a RAM normal
4100 LOCATE SPRITE_X, SPRITE_Y
4110 IF TIPO_SPRITE = 1 THEN PEN 3: SYMBOL 250, PEEK(&4000),PEEK(&4001),PEEK(&4002),PEEK(&4003),PEEK(&4004),PEEK(&4005),PEEK(&4006),PEEK(&4007): PRINT CHR$(250)
4120 IF TIPO_SPRITE = 2 THEN PEN 2: SYMBOL 251, PEEK(&4008),PEEK(&4009),PEEK(&400A),PEEK(&400B),PEEK(&400C),PEEK(&400D),PEEK(&400E),PEEK(&400F): PRINT CHR$(251)
4130 RETURN
