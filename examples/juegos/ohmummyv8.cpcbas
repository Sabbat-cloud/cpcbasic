10 : ' OH MUMMY V8 - PANTALLA DE TITULO, HISCORES Y SIN MUSICA INGAME
20 MODE 0
30 INK 0,0: INK 1,1: INK 2,24: INK 3,6: INK 4,26: INK 5,13: INK 6,8: INK 7,20: INK 8,18: INK 9,2: INK 10,3: INK 11,9: INK 12,5: INK 13,12: INK 14,16: INK 15,15
40 DEFINT A-Z: RANDOMIZE TIME
50 GOSUB 3000 : ' Cargar Sprites en Memoria RAM (&4000)
60 ENV 1, 15, -1, 10: ENT 1, 15, -1, 2
70 : ' DEFINIR CARACTERES (PARA FONDOS Y OBJETOS)
80 SYMBOL 252, 24, 24, 24, 24, 24, 24, 24, 24 : ' HUELLA VERTICAL
90 SYMBOL 253, 0, 0, 0, 255, 255, 0, 0, 0 : ' HUELLA HORIZONTAL
100 SYMBOL 254, 0, 60, 126, 255, 255, 126, 60, 0 : ' LLAVE
110 SYMBOL 255, 126, 255, 219, 219, 255, 255, 255, 126 : ' TUMBA
120 SYMBOL 249, 60, 126, 219, 219, 126, 60, 60, 60 : ' PERGAMINO
130 SYMBOL 248, 0, 126, 255, 219, 255, 126, 0, 0 : ' COFRE/TESORO
140 : ' INICIALIZAR VARIABLES DE JUEGO Y ARRAYS
150 DIM SALA(4,4), BORDES(18,20), SALAESTADO(4,4)
160 DIM MX(5), MY(5), OMX(5), OMY(5), BOLSA(16), MUDIR(5)
162 DIM HIS(5), HIN$(5)
164 FOR I=1 TO 5: HIS(I)=6000-I*1000: HIN$(I)="CPU": NEXT I
165 GOTO 10000 : ' PANTALLA DE TITULO
170 NIVEL = 1: VIDAS = 6: PUNTOS = 0
180 : ' BUCLE DE INICIO DE NIVEL
190 CLS: LOCATE 1,1: PEN 4: PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
200 NUMMOMIAS = 1 + INT((NIVEL-1)/2): IF NUMMOMIAS > 5 THEN NUMMOMIAS = 5
210 FOR F=1 TO 4: FOR C=1 TO 4: SALA(C,F)=0: SALAESTADO(C,F)=0: NEXT C,F
220 FOR X=1 TO 18: FOR Y=1 TO 20: BORDES(X,Y)=0: NEXT Y,X
230 : ' ASIGNAR OBJETOS FIJOS (16 huecos)
240 FOR I=1 TO 6: BOLSA(I)=5: NEXT I
250 BOLSA(7)=1: BOLSA(8)=2: BOLSA(9)=3: BOLSA(10)=4
260 FOR I=11 TO 16: BOLSA(I)=0: NEXT I
270 FOR I=1 TO 16: R=INT(RND*16)+1: SW=BOLSA(I): BOLSA(I)=BOLSA(R): BOLSA(R)=SW: NEXT I
280 I=1: FOR F=1 TO 4: FOR C=1 TO 4: SALA(C,F)=BOLSA(I): I=I+1: NEXT C,F
290 : ' DIBUJAR PANTALLA (17x20 celdas)
300 LOCATE 6,2: PEN 8: PRINT CHR$(143)
310 LOCATE 8,2: PEN 8: PRINT CHR$(143)
320 FOR F=1 TO 4
330   FOR C=1 TO 4
340     X = (C-1)*4 + 2: Y = (F-1)*4 + 4
350     LOCATE X,Y: PEN 10: PRINT CHR$(143);CHR$(143);CHR$(143)
360     LOCATE X,Y+1: PEN 10: PRINT CHR$(143);CHR$(143);CHR$(143)
370     LOCATE X,Y+2: PEN 10: PRINT CHR$(143);CHR$(143);CHR$(143)
380   NEXT C
390 NEXT F
400 : ' POSICION INICIAL DEL JUGADOR Y MOMIAS
410 JX = 1: JY = 3: BORDES(JX,JY) = 1: PLDIR = 0
420 SP = PLDIR: SPRX = JX: SPRY = JY: GOSUB 4000
430 FOR M=1 TO NUMMOMIAS
440   MX(M) = 17: MY(M) = 19: OMX(M) = MX(M): OMY(M) = MY(M): MUDIR(M) = 2
450   SP = MUDIR(M): SPRX = MX(M): SPRY = MY(M): GOSUB 4000
460 NEXT M
470 LLAVEENCONTRADA = 0: TUMBAENCONTRADA = 0: PODER = 0
480 : ' LA MUSICA AHORA ESTA APAGADA INGAME (SOLO EN EL TITULO)
490 : ' BUCLE PRINCIPAL
500 I$ = INKEY$
510 OX = JX: OY = JY
520 IF INKEY(8) <> -1 THEN JX=JX-1: PLDIR=1
530 IF INKEY(1) <> -1 THEN JX=JX+1: PLDIR=0
540 IF INKEY(0) <> -1 THEN JY=JY-1
550 IF INKEY(2) <> -1 THEN JY=JY+1
560 : ' COMPROBAR LIMITES Y SALIDA
570 IF JX=7 AND JY=2 AND LLAVEENCONTRADA=1 AND TUMBAENCONTRADA=1 THEN GOTO 1500
580 IF JX<1 OR JX>17 OR JY<3 OR JY>19 THEN JX=OX: JY=OY
590 CX = (JX-1) MOD 4: CY = (JY-3) MOD 4
600 IF CX > 0 AND CY > 0 THEN JX=OX: JY=OY
610 : ' MOVER JUGADOR
620 IF JX=OX AND JY=OY THEN GOTO 680
630 LOCATE OX,OY: PEN 14
640 IF (OX-1) MOD 4 = 0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
650 BORDES(JX,JY) = 1
660 SP = PLDIR: SPRX = JX: SPRY = JY: GOSUB 4000
670 SOUND 2,100,2,10: GOSUB 1000
680 : ' IA DE MOMIAS
690 MOMIAASESINA = 0
700 FOR M=1 TO NUMMOMIAS
710   IF RND * 10 > (3 + NIVEL) THEN GOTO 880
720   OMX(M) = MX(M): OMY(M) = MY(M)
730   CMX = (MX(M)-1) MOD 4: CMY = (MY(M)-3) MOD 4
740   IF CMX <> 0 OR CMY <> 0 THEN GOTO 810
750   DX = JX - MX(M): DY = JY - MY(M)
760   IF ABS(DX) > ABS(DY) AND DX <> 0 THEN MX(M) = MX(M) + SGN(DX): MUDIR(M) = 2 - (SGN(DX)<0): GOTO 860
770   IF DY <> 0 THEN MY(M) = MY(M) + SGN(DY): GOTO 860
780   IF DX <> 0 THEN MX(M) = MX(M) + SGN(DX): MUDIR(M) = 2 - (SGN(DX)<0)
790   GOTO 860
810   IF CMX = 0 THEN IF JY > MY(M) THEN MY(M) = MY(M) + 1 ELSE IF JY < MY(M) THEN MY(M) = MY(M) - 1
820   IF CMX <> 0 THEN IF JX > MX(M) THEN MX(M) = MX(M) + 1: MUDIR(M)=2 ELSE IF JX < MX(M) THEN MX(M) = MX(M) - 1: MUDIR(M)=3
860   IF MX(M)<1 OR MX(M)>17 OR MY(M)<3 OR MY(M)>19 THEN MX(M)=OMX(M): MY(M)=OMY(M)
880   IF MX(M)=OMX(M) AND MY(M)=OMY(M) THEN GOTO 940
890   LOCATE OMX(M),OMY(M): PEN 14
900   IF BORDES(OMX(M),OMY(M))=0 THEN PRINT " ": GOTO 930
910   IF (OMX(M)-1) MOD 4 = 0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
930   SP = MUDIR(M): SPRX = MX(M): SPRY = MY(M): GOSUB 4000
940   IF MX(M)=JX AND MY(M)=JY THEN MOMIAASESINA = M
950 NEXT M
960 IF MOMIAASESINA > 0 THEN GOTO 1310
970 : ' RETARDO ELIMINADO para maxima fluidez
980 GOTO 490
990 : ' RUTINA RECUADROS CERRADOS
1000 C1 = INT((JX-1)/4): IF (JX-1) MOD 4 <> 0 THEN C1 = C1 + 1
1010 C2 = INT((JX-1)/4) + 1
1020 IF C1 < 1 THEN C1 = 1
1030 IF C2 > 4 THEN C2 = 4
1040 F1 = INT((JY-3)/4): IF (JY-3) MOD 4 <> 0 THEN F1 = F1 + 1
1050 F2 = INT((JY-3)/4) + 1
1060 IF F1 < 1 THEN F1 = 1
1070 IF F2 > 4 THEN F2 = 4
1080 FOR C = C1 TO C2
1090   FOR F = F1 TO F2
1100     IF SALAESTADO(C,F) = 1 THEN GOTO 1270
1110     X = (C-1)*4 + 1: Y = (F-1)*4 + 3: CERRADO = 1: K = 0
1120     WHILE K <= 4 AND CERRADO = 1
1130       IF BORDES(X+K,Y)=0 THEN CERRADO=0
1140       IF BORDES(X+K,Y+4)=0 THEN CERRADO=0
1150       IF BORDES(X,Y+K)=0 THEN CERRADO=0
1160       IF BORDES(X+4,Y+K)=0 THEN CERRADO=0
1170       K = K + 1
1180     WEND
1190     IF CERRADO = 0 THEN GOTO 1270
1200     SALAESTADO(C,F) = 1: PUNTOS = PUNTOS + 50
1210     LOCATE 1,1: PEN 4: PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
1220     FOR DY=1 TO 3: LOCATE X+1, Y+DY: PRINT "   ": NEXT DY
1230     LOCATE X+2, Y+2: OBJ = SALA(C,F)
1240     IF OBJ = 1 THEN PEN 7: PRINT CHR$(254): LLAVEENCONTRADA=1
1250     IF OBJ = 2 THEN PEN 12: PRINT CHR$(255): TUMBAENCONTRADA=1
1260     IF OBJ = 3 THEN PEN 15: PRINT CHR$(249): PODER=1
1262     IF OBJ = 4 AND NUMMOMIAS < 5 THEN NUMMOMIAS = NUMMOMIAS + 1: MX(NUMMOMIAS)=X+2: MY(NUMMOMIAS)=Y+2: OMX(NUMMOMIAS)=X+2: OMY(NUMMOMIAS)=Y+2: MUDIR(NUMMOMIAS)=3: SP=3: SPRX=MX(NUMMOMIAS): SPRY=MY(NUMMOMIAS): GOSUB 4000
1265     IF OBJ = 5 THEN PEN 2: PRINT CHR$(248): PUNTOS = PUNTOS + 100: LOCATE 1,1: PEN 4: PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
1268     SOUND 4, 200, 20, 15
1270   NEXT F
1280 NEXT C
1290 RETURN
1300 : ' COLISION
1310 IF PODER = 1 THEN GOTO 1400
1320 SOUND 1, 800, 40, 15: SOUND 2, 900, 40, 15
1330 VIDAS = VIDAS - 1: IF VIDAS>0 THEN GOTO 1420
1340 LOCATE 1,20: PEN 4: PRINT "   GAME OVER   "
1350 FOR P=1 TO 1500: NEXT P
1360 R = 0: FOR I=1 TO 5: IF PUNTOS > HIS(I) THEN R = I: I = 5
1370 NEXT I
1380 IF R = 0 THEN GOTO 10000
1382 CLS: LOCATE 1,10: PEN 4: PRINT "  NUEVO RECORD!"
1384 LOCATE 1,12: PRINT "INICIALES (MAX 5):"
1386 LOCATE 1,14: LINE INPUT "", N$
1388 IF LEN(N$)>5 THEN N$=LEFT$(N$,5)
1390 FOR I=5 TO R+1 STEP -1: HIS(I)=HIS(I-1): HIN$(I)=HIN$(I-1): NEXT I
1392 HIS(R)=PUNTOS: HIN$(R)=N$
1394 GOTO 10000
1400 PUNTOS = PUNTOS + 100: SOUND 4, 150, 10, 15: PODER = 0
1420 LOCATE 1,1: PEN 4: PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
1430 FOR I = MOMIAASESINA TO NUMMOMIAS - 1
1440   MX(I) = MX(I+1): MY(I) = MY(I+1): OMX(I) = OMX(I+1): OMY(I) = OMY(I+1): MUDIR(I) = MUDIR(I+1)
1450 NEXT I
1460 NUMMOMIAS = NUMMOMIAS - 1
1470 SP=PLDIR: SPRX=JX: SPRY=JY: GOSUB 4000
1480 GOTO 490
1500 : ' PASA DE NIVEL
1520 LOCATE 1,20: PRINT "NIVEL COMPLETADO!"
1530 SOUND 2, 100, 50, 15: SOUND 4, 150, 50, 15
1540 FOR P=1 TO 500: NEXT P
1550 NIVEL = NIVEL + 1: GOTO 180
2000 : ' RUTINA DE MUSICA (Arabian Riff)
2005 rem HUECOS = SQ(1): FOR Z = 1 TO HUECOS
2010 rem READ P, D, V: IF P = -1 THEN RESTORE 2100: READ P, D, V
2030 rem SOUND 1, P, D, V, 1, 1
2035 rem NEXT Z
2040 rem ETURN
2100 rem DATA 319,15,10, 319,15,10, 338,10,10, 319,30,10, 0,10,0
2120 rem DATA 319,15,10, 338,15,10, 402,15,10, 426,30,10, 0,10,0
2140 rem DATA 402,15,10, 358,15,10, 402,15,10, 426,30,10, 0,10,0
2160 rem DATA 478,15,10, 506,15,10, 478,30,10, 0,20,0, -1,-1,-1
3000 : ' CARGAR SPRITES EN RAM (&4000)
3010 RESTORE 3100
3020 FOR S = 0 TO 3
3030   FOR B = 0 TO 31
3040     READ C: POKE &4000 + S * 32 + B, C
3050   NEXT B
3060 NEXT S
3070 RESTORE 2100 : ' Reset para la musica
3080 RETURN
3100 DATA 0,195,130,0,0,134,255,0,0,134,255,0,4,73,130,0,0,93,255,0,0,195,130,0,0,65,130,0,0,85,170,0
3110 DATA 0,195,130,0,0,4,195,0,0,85,130,0,0,195,134,0,0,215,73,0,0,65,130,0,0,65,130,0,0,255,170,0
3120 DATA 0,4,0,0,0,12,8,0,0,12,0,0,0,12,12,8,0,12,8,0,0,12,8,0,0,12,8,0,0,12,8,0
3130 DATA 0,4,8,0,0,4,8,0,0,4,8,0,4,12,0,0,0,4,8,0,0,4,8,0,0,4,8,0,0,12,8,0
4000 : ' Z80 POKE SPRITE A PANTALLA
4010 DIRP = &C000 + (SPRY - 1) * 80 + (SPRX - 1) * 4
4020 DIRS = &4000 + SP * 32
4030 POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4040 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4050 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4060 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4070 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4080 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4090 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4100 DIRP=DIRP+&800: DIRS=DIRS+4: POKE DIRP, PEEK(DIRS): POKE DIRP+1, PEEK(DIRS+1): POKE DIRP+2, PEEK(DIRS+2): POKE DIRP+3, PEEK(DIRS+3)
4110 RETURN
10000 : ' PANTALLA DE TITULO Y PRESENTACION
10010 CLS
10020 LOCATE 4,2: PEN 2: PRINT "O H   M U M M Y !"
10030 LOCATE 1,5: PEN 3: PRINT "Eres un intrepido"
10040 LOCATE 1,6: PRINT "explorador buscando"
10050 LOCATE 1,7: PRINT "tesoros perdidos de"
10060 LOCATE 1,8: PRINT "los grandes faraones."
10070 LOCATE 1,10: PRINT "Tu mision consiste en"
10080 LOCATE 1,11: PRINT "encontrarlos y escapar"
10090 LOCATE 1,12: PRINT "de la piramide..."
10100 LOCATE 1,13: PRINT "Pero cuidado con los"
10110 LOCATE 1,14: PRINT "guardianes inmortales!"
10120 LOCATE 1,17: PEN 4: PRINT "MEJORES PUNTUACIONES"
10130 FOR I=1 TO 5: LOCATE 2,17+I: PEN 2: PRINT HIN$(I);: LOCATE 10,17+I: PRINT HIS(I): NEXT I
10140 LOCATE 1,25: PEN 14: PRINT "PULSA ENTER...";
10150 RESTORE 2100
10160 FRAME: IF SQ(1) > 0 THEN GOSUB 2000
10165 IF INKEY(18) = -1 AND INKEY(6) = -1 THEN GOTO 10160
10170 SOUND 129,0,0,0 : ' SILENCIAR Y VACIAR CANAL
10180 NIVEL = 1: VIDAS = 6: PUNTOS = 0
10190 GOTO 180 : ' EMPEZAR JUEGO
