1 GOSUB 1000:GOTO 100
10 DIRP=&BFAC+SPRY*80+SPRX*4:DIRS=&4000+SP*32
11 POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
12 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
13 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
14 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
15 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
16 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
17 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3)
18 DIRP=DIRP+&800:DIRS=DIRS+4:POKE DIRP,PEEK(DIRS):POKE DIRP+1,PEEK(DIRS+1):POKE DIRP+2,PEEK(DIRS+2):POKE DIRP+3,PEEK(DIRS+3):RETURN
20 I$=INKEY$:OX=JX:OY=JY
21 IF INKEY(8)<>-1 THEN JX=JX-1:PLDIR=1
22 IF INKEY(1)<>-1 THEN JX=JX+1:PLDIR=0
23 IF INKEY(0)<>-1 THEN JY=JY-1
24 IF INKEY(2)<>-1 THEN JY=JY+1
25 IF JX=7 AND JY=2 AND LLAVEENCONTRADA=1 AND TUMBAENCONTRADA=1 THEN GOTO 90
26 IF JX<1 OR JX>17 OR JY<3 OR JY>19 THEN JX=OX:JY=OY
27 CX=(JX-1) AND 3:CY=(JY-3) AND 3:IF CX>0 AND CY>0 THEN JX=OX:JY=OY
28 IF JX=OX AND JY=OY THEN GOTO 32
29 LOCATE OX,OY:PEN 14:IF ((OX-1) AND 3)=0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
30 BORDES(JX,JY)=1:SP=PLDIR:SPRX=JX:SPRY=JY:GOSUB 10
31 SOUND 2,100,2,10:GOSUB 50
32 MOMIAASESINA=0:FOR M=1 TO NUMMOMIAS
33 IF RND*10>(3+NIVEL) THEN GOTO 46
34 OMX(M)=MX(M):OMY(M)=MY(M):CMX=(MX(M)-1) AND 3:CMY=(MY(M)-3) AND 3
35 IF CMX<>0 OR CMY<>0 THEN GOTO 40
36 DX=JX-MX(M):DY=JY-MY(M)
37 IF ABS(DX)>ABS(DY) AND DX<>0 THEN MX(M)=MX(M)+SGN(DX):MUDIR(M)=2-(SGN(DX)<0):GOTO 42
38 IF DY<>0 THEN MY(M)=MY(M)+SGN(DY):GOTO 42
39 IF DX<>0 THEN MX(M)=MX(M)+SGN(DX):MUDIR(M)=2-(SGN(DX)<0):GOTO 42 ELSE GOTO 42
40 IF CMX=0 THEN IF JY>MY(M) THEN MY(M)=MY(M)+1 ELSE IF JY<MY(M) THEN MY(M)=MY(M)-1
41 IF CMX<>0 THEN IF JX>MX(M) THEN MX(M)=MX(M)+1:MUDIR(M)=2 ELSE IF JX<MX(M) THEN MX(M)=MX(M)-1:MUDIR(M)=3
42 IF MX(M)<1 OR MX(M)>17 OR MY(M)<3 OR MY(M)>19 THEN MX(M)=OMX(M):MY(M)=OMY(M)
43 IF MX(M)=OMX(M) AND MY(M)=OMY(M) THEN GOTO 46
44 LOCATE OMX(M),OMY(M):PEN 14:IF BORDES(OMX(M),OMY(M))=0 THEN PRINT " ":GOTO 45 ELSE IF ((OMX(M)-1) AND 3)=0 THEN PRINT CHR$(252) ELSE PRINT CHR$(253)
45 SP=MUDIR(M):SPRX=MX(M):SPRY=MY(M):GOSUB 10
46 IF MX(M)=JX AND MY(M)=JY THEN MOMIAASESINA=M
47 NEXT M
48 IF MOMIAASESINA>0 THEN GOTO 75
49 GOTO 20
50 T1=INT((JX-1)/4):C1=T1:IF (JX-1) AND 3 THEN C1=C1+1
51 C2=T1+1:IF C1<1 THEN C1=1
52 IF C2>4 THEN C2=4
53 T2=INT((JY-3)/4):F1=T2:IF (JY-3) AND 3 THEN F1=F1+1
54 F2=T2+1:IF F1<1 THEN F1=1
55 IF F2>4 THEN F2=4
56 FOR C=C1 TO C2:FOR F=F1 TO F2
57 IF SALAESTADO(C,F)=1 THEN GOTO 72
58 X=(C-1)*4+1:Y=(F-1)*4+3:CERRADO=1:K=0
59 WHILE K<=4 AND CERRADO=1
60 IF BORDES(X+K,Y)=0 THEN CERRADO=0:GOTO 62 ELSE IF BORDES(X+K,Y+4)=0 THEN CERRADO=0:GOTO 62 ELSE IF BORDES(X,Y+K)=0 THEN CERRADO=0:GOTO 62 ELSE IF BORDES(X+4,Y+K)=0 THEN CERRADO=0:GOTO 62
61 K=K+1:WEND
62 IF CERRADO=0 THEN GOTO 72
63 SALAESTADO(C,F)=1:PUNTOS=PUNTOS+50:LOCATE 1,1:PEN 4:PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
64 FOR DY=1 TO 3:LOCATE X+1,Y+DY:PRINT "   ":NEXT DY
65 LOCATE X+2,Y+2:OBJ=SALA(C,F)
66 IF OBJ=1 THEN PEN 7:PRINT CHR$(254):LLAVEENCONTRADA=1
67 IF OBJ=2 THEN PEN 12:PRINT CHR$(255):TUMBAENCONTRADA=1
68 IF OBJ=3 THEN PEN 15:PRINT CHR$(249):PODER=1
69 IF OBJ=4 AND NUMMOMIAS<5 THEN NUMMOMIAS=NUMMOMIAS+1:MX(NUMMOMIAS)=X+2:MY(NUMMOMIAS)=Y+2:OMX(NUMMOMIAS)=X+2:OMY(NUMMOMIAS)=Y+2:MUDIR(NUMMOMIAS)=3:SP=3:SPRX=MX(NUMMOMIAS):SPRY=MY(NUMMOMIAS):GOSUB 10
70 IF OBJ=5 THEN PEN 2:PRINT CHR$(248):PUNTOS=PUNTOS+100:LOCATE 1,1:PEN 4:PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
71 SOUND 4,200,20,15
72 NEXT F:NEXT C:RETURN
75 IF PODER=1 THEN PUNTOS=PUNTOS+100:SOUND 4,150,10,15:PODER=0:GOTO 79
76 SOUND 1,800,40,15:SOUND 2,900,40,15:VIDAS=VIDAS-1:IF VIDAS>0 THEN GOTO 79
77 LOCATE 1,20:PEN 4:PRINT "   GAME OVER   ":FOR P=1 TO 1500:NEXT P
78 GOSUB 1050:GOTO 100
79 LOCATE 1,1:PEN 4:PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
80 FOR I=MOMIAASESINA TO NUMMOMIAS-1:MX(I)=MX(I+1):MY(I)=MY(I+1):OMX(I)=OMX(I+1):OMY(I)=OMY(I+1):MUDIR(I)=MUDIR(I+1):NEXT I
81 NUMMOMIAS=NUMMOMIAS-1:SP=PLDIR:SPRX=JX:SPRY=JY:GOSUB 10:GOTO 20
90 LOCATE 1,20:PRINT "NIVEL COMPLETADO!":SOUND 2,100,50,15:SOUND 4,150,50,15
91 FOR P=1 TO 500:NEXT P:NIVEL=NIVEL+1:GOTO 100
100 CLS:LOCATE 1,1:PEN 4:PRINT "L:";NIVEL;" P:";PUNTOS;" V:";VIDAS
101 NUMMOMIAS=1+INT((NIVEL-1)/2):IF NUMMOMIAS>5 THEN NUMMOMIAS=5
102 FOR F=1 TO 4:FOR C=1 TO 4:SALA(C,F)=0:SALAESTADO(C,F)=0:NEXT C,F
103 FOR X=1 TO 18:FOR Y=1 TO 20:BORDES(X,Y)=0:NEXT Y,X
104 FOR I=1 TO 6:BOLSA(I)=5:NEXT I:BOLSA(7)=1:BOLSA(8)=2:BOLSA(9)=3:BOLSA(10)=4:FOR I=11 TO 16:BOLSA(I)=0:NEXT I
105 FOR I=1 TO 16:R=INT(RND*16)+1:SW=BOLSA(I):BOLSA(I)=BOLSA(R):BOLSA(R)=SW:NEXT I
106 I=1:FOR F=1 TO 4:FOR C=1 TO 4:SALA(C,F)=BOLSA(I):I=I+1:NEXT C,F
107 LOCATE 6,2:PEN 8:PRINT CHR$(143):LOCATE 8,2:PRINT CHR$(143)
108 FOR F=1 TO 4:FOR C=1 TO 4:X=(C-1)*4+2:Y=(F-1)*4+4
109 LOCATE X,Y:PEN 10:PRINT CHR$(143);CHR$(143);CHR$(143)
110 LOCATE X,Y+1:PRINT CHR$(143);CHR$(143);CHR$(143)
111 LOCATE X,Y+2:PRINT CHR$(143);CHR$(143);CHR$(143):NEXT C,F
112 JX=1:JY=3:BORDES(JX,JY)=1:PLDIR=0:SP=PLDIR:SPRX=JX:SPRY=JY:GOSUB 10
113 FOR M=1 TO NUMMOMIAS:MX(M)=17:MY(M)=19:OMX(M)=17:OMY(M)=19:MUDIR(M)=2:SP=2:SPRX=17:SPRY=19:GOSUB 10:NEXT M
114 LLAVEENCONTRADA=0:TUMBAENCONTRADA=0:PODER=0:GOTO 20
1000 MODE 0:INK 0,0:INK 1,1:INK 2,24:INK 3,6:INK 4,26:INK 5,13:INK 6,8:INK 7,20:INK 8,18:INK 9,2:INK 10,3:INK 11,9:INK 12,5:INK 13,12:INK 14,16:INK 15,15
1001 DEFINT A-Z:RANDOMIZE TIME:ENV 1,15,-1,10:ENT 1,15,-1,2
1002 SYMBOL 252,24,24,24,24,24,24,24,24:SYMBOL 253,0,0,0,255,255,0,0,0
1003 SYMBOL 254,0,60,126,255,255,126,60,0:SYMBOL 255,126,255,219,219,255,255,255,126
1004 SYMBOL 249,60,126,219,219,126,60,60,60:SYMBOL 248,0,126,255,219,255,126,0,0
1005 DIM SALA(4,4),BORDES(18,20),SALAESTADO(4,4),MX(5),MY(5),OMX(5),OMY(5),BOLSA(16),MUDIR(5),HIS(5),HIN$(5)
1006 FOR I=1 TO 5:HIS(I)=6000-I*1000:HIN$(I)="CPU":NEXT I
1007 RESTORE 1200:FOR S=0 TO 3:FOR B=0 TO 31:READ C:POKE &4000+S*32+B,C:NEXT B,S
1008 GOTO 1060
1050 R=0:FOR I=1 TO 5:IF PUNTOS>HIS(I) THEN R=I:I=5
1051 NEXT I:IF R=0 THEN GOTO 1060
1052 CLS:LOCATE 1,10:PEN 4:PRINT "  NUEVO RECORD!":LOCATE 1,12:PRINT "INICIALES (MAX 5):":LOCATE 1,14:LINE INPUT "",N$
1053 IF LEN(N$)>5 THEN N$=LEFT$(N$,5)
1054 FOR I=5 TO R+1 STEP -1:HIS(I)=HIS(I-1):HIN$(I)=HIN$(I-1):NEXT I:HIS(R)=PUNTOS:HIN$(R)=N$
1060 CLS:LOCATE 4,2:PEN 2:PRINT "O H   M U M M Y !":LOCATE 1,5:PEN 3:PRINT "Eres un intrepido":LOCATE 1,6:PRINT "explorador buscando"
1061 LOCATE 1,7:PEN 3:PRINT "tesoros perdidos de":LOCATE 1,8:PRINT "los grandes faraones.":LOCATE 1,10:PRINT "Tu mision consiste en"
1062 LOCATE 1,11:PEN 3:PRINT "encontrarlos y escapar":LOCATE 1,12:PRINT "de la piramide...":LOCATE 1,13:PRINT "Pero cuidado con los"
1063 LOCATE 1,14:PEN 3:PRINT "guardianes inmortales!":LOCATE 1,17:PEN 4:PRINT "MEJORES PUNTUACIONES"
1064 FOR I=1 TO 5:LOCATE 2,17+I:PEN 2:PRINT HIN$(I);:LOCATE 10,17+I:PRINT HIS(I):NEXT I
1065 LOCATE 1,25:PEN 14:PRINT "PULSA ENTER...";
1066 FRAME:IF INKEY(18)=-1 AND INKEY(6)=-1 THEN GOTO 1066
1067 SOUND 129,0,0,0:NIVEL=1:VIDAS=6:PUNTOS=0:RETURN
1200 DATA 0,195,130,0,0,134,255,0,0,134,255,0,4,73,130,0,0,93,255,0,0,195,130,0,0,65,130,0,0,85,170,0
1201 DATA 0,195,130,0,0,4,195,0,0,85,130,0,0,195,134,0,0,215,73,0,0,65,130,0,0,65,130,0,0,255,170,0
1202 DATA 0,4,0,0,0,12,8,0,0,12,0,0,0,12,12,8,0,12,8,0,0,12,8,0,0,12,8,0,0,12,8,0
1203 DATA 0,4,8,0,0,4,8,0,0,4,8,0,4,12,0,0,0,4,8,0,0,4,8,0,0,4,8,0,0,12,8,0
