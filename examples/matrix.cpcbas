10 MODE 1
20 CLS
30 FOR I = 1 TO 20
40 X = INT(RND() * 40) + 1
50 Y = INT(RND() * 25) + 1
60 C = INT(RND() * 15) + 1
70 CHAR$ = CHR$(INT(RND() * 26) + 65)
80 GOSUB 1000
90 NEXT I
100 LOCATE 1, 24
110 PRINT "PRESIONA UNA TECLA PARA SALIR"
120 IF INKEY$ = "" THEN 120
130 END
1000 REM Subrutina de pintado
1010 LOCATE X, Y
1020 PEN C
1030 PRINT CHAR$
1040 SOUND 1, INT(RND()*200)+50, 5, 15
1050 RETURN
