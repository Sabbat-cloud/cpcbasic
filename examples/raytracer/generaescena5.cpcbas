10 REM --- GENERADOR ESCENA 5 (SATURNO Y NAVE) ---
20 PRINT "Generando s5.scn..."
30 OPENOUT "s5.scn"
40 WRITE#9, 15,15,-5 : REM Posicion de la Luz (Arriba a la derecha)
50 WRITE#9, 13 : REM Numero total de esferas (Saturno + Anillo + Nave)
60 REM 1. Planeta Gigante (Saturno - Amarillo)
70 WRITE#9, 0,4,25, 64, 4 : REM Centro (0,4,25), Radio^2=64
80 REM 2. Anillos (8 esferas amarillas orbitando en el plano horizontal)
90 WRITE#9, 12,4,25, 2.25, 4
100 WRITE#9, 8.5,4,33.5, 2.25, 4
110 WRITE#9, 0,4,37, 2.25, 4
120 WRITE#9, -8.5,4,33.5, 2.25, 4
130 WRITE#9, -12,4,25, 2.25, 4
140 WRITE#9, -8.5,4,16.5, 2.25, 4
150 WRITE#9, 0,4,13, 2.25, 4
160 WRITE#9, 8.5,4,16.5, 2.25, 4
170 REM 3. Nave Espacial (Cerca de la camara)
180 WRITE#9, -4,-1,7, 2.25, 2 : REM Fuselaje principal (Azul)
190 WRITE#9, -3.5,0,5.5, 0.49, 3 : REM Cabina de cristal (Verde)
200 WRITE#9, -2.5,-1,7.5, 0.64, 1 : REM Motor derecho (Rojo)
210 WRITE#9, -5.5,-1,7.5, 0.64, 1 : REM Motor izquierdo (Rojo)
220 CLOSEOUT
230 PRINT "¡Escena s5 generada con exito!"
