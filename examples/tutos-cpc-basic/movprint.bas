10 'mover & print
15 MODE 0:TAG
20 MOVE 320,200:PRINT CHR$(224);
30 IF INKEY(2)=0 THEN MOVER 0,-2:PRINT CHR$(224);:MOVER -32,0
40 IF INKEY(0)=0 THEN MOVER 0,2:PRINT CHR$(224);:MOVER -32,0
50 IF INKEY(8)=0 THEN MOVER -2,0:PRINT CHR$(224);:MOVER -32,0
60 IF INKEY(1)=0 THEN MOVER 2,0:PRINT CHR$(224);:MOVER -32,0
70 GOTO 30
