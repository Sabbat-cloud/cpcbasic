10 'starfield
20 MODE 0:INK 0,0:INK 1,26:BORDER 0:CLS
30 CX=320:CY=200:NB=50
40 DIM X(50),Y(50),Z(50),OX(50),OY(50)
50 FOR I=1 TO NB:GOSUB 150:Z(I)=RND*100+10:NEXT I
60 FOR I=1 TO NB
70 IF OX(I)<>0 THEN PLOT OX(I),OY(I),0
80 Z(I)=Z(I)-4
90 IF Z(I)<=1 THEN GOSUB 150:GOTO 130
100 PX=CX+(X(I)*16/Z(I)):PY=CY+(Y(I)*16/Z(I))
110 IF PX<0 OR PX>639 OR PY<0 OR PY>399 THEN GOSUB 150:GOTO 130
120 PLOT PX,PY,1:OX(I)=PX:OY(I)=PY
130 NEXT I
140 GOTO 60
150 X(I)=(RND*160)+40:IF RND*2>1 THEN X(I)=-X(I)
160 Y(I)=(RND*160)+40:IF RND*2>1 THEN Y(I)=-Y(I)
170 Z(I)=100:OX(I)=0:RETURN
