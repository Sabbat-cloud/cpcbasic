10 REM =====================================
20 REM RETRO-IDE: EDITOR CON HIGHLIGHTING
30 REM =====================================
40 MODE 2: BORDER 0
50 REM Definir paleta: 0=Fondo, 1=Normal, 2=Palabras clave, 3=Valores
60 INK 0,0: INK 1,24: INK 2,18: INK 3,6
70 DIM T$(100) : REM Array para guardar 100 lineas de texto
80 MAXL=0
85 CURRENT_FILE$="<Ninguno>"
90 REM --- MENU PRINCIPAL ---
100 CLS: PEN 1: PRINT "--- RETRO IDE (PYTHON) ---"
105 PRINT "Fichero actual: "; CURRENT_FILE$
110 PRINT "1. Escribir texto"
120 PRINT "2. Ver codigo (Sintaxis)"
130 PRINT "3. Guardar fichero"
140 PRINT "4. Cargar fichero"
150 PRINT "5. Editar codigo"
155 PRINT "6. Salir"
160 LOCATE 1,10: PRINT "Elige opcion: ";
170 A$ = INKEY$: IF A$="" THEN 170
180 OP = VAL(A$)
190 IF OP=1 THEN GOSUB 1000
200 IF OP=2 THEN GOSUB 2000
210 IF OP=3 THEN GOSUB 3000
220 IF OP=4 THEN GOSUB 4000
230 IF OP=5 THEN GOSUB 6000
235 IF OP=6 THEN END
240 GOTO 90

1000 REM --- 1. ESCRIBIR TEXTO ---
1010 CLS: PRINT "Escribe. Linea vacia para terminar."
1020 FOR I = MAXL+1 TO 100
1030 PRINT I;":";
1040 LINE INPUT A$
1050 IF A$="" THEN MAXL=I-1: RETURN
1060 T$(I) = A$
1070 NEXT I
1080 MAXL=100: RETURN

2000 REM --- 2. VER TEXTO (RESALTADO) ---
2010 CLS: PRINT "--- CODIGO FUENTE ---"
2020 FOR I = 1 TO MAXL
2030 A$ = T$(I)
2040 GOSUB 5000 : REM Llama al motor de resaltado
2050 PRINT : REM Salto de linea
2060 NEXT I
2065 PRINT "Pulsa una tecla..."
2070 A$=INKEY$: IF A$="" THEN 2070
2080 RETURN

3000 REM --- 3. GUARDAR FICHERO ---
3010 LOCATE 1,12: LINE INPUT "Nombre del fichero? ", F$
3020 IF F$="" THEN RETURN
3030 OPENOUT F$
3040 FOR I=1 TO MAXL
3050 PRINT #9, T$(I)
3060 NEXT I
3070 CLOSEOUT
3075 CURRENT_FILE$ = F$
3080 PRINT "Guardado con exito!": FOR W=1 TO 500: NEXT W: RETURN

4000 REM --- 4. CARGAR FICHERO ---
4010 LOCATE 1,12: LINE INPUT "Nombre del fichero? ", F$
4020 IF F$="" THEN RETURN
4030 OPENIN F$
4040 I=0
4050 IF EOF THEN 4100
4060 I=I+1
4070 LINE INPUT #9, A$
4075 T$(I) = A$
4080 GOTO 4050
4100 CLOSEIN
4110 MAXL=I
4115 CURRENT_FILE$ = F$
4120 PRINT "Cargado con exito!": FOR W=1 TO 500: NEXT W: RETURN

5000 REM --- MOTOR DE RESALTADO DE SINTAXIS ---
5010 L = LEN(A$): P = 1
5020 IF P > L THEN RETURN
5030 W$ = ""
5040 C$ = MID$(A$, P, 1)
5050 REM Delimitadores: espacio, parentesis, dos puntos, comas
5060 IF C$=" " OR C$="(" OR C$=")" OR C$=":" OR C$="," THEN 5100
5070 W$ = W$ + C$
5080 P = P + 1
5090 IF P <= L THEN GOTO 5040
5100 REM Analizar la palabra encontrada
5110 IF W$="" THEN 5160
5120 C = 1 : REM Color por defecto (PEN 1)
5130 REM Lista de palabras clave de Python (PEN 2)
5140 IF W$="def" OR W$="import" OR W$="print" OR W$="if" OR W$="for" THEN C = 2
5150 PEN C: PRINT W$;
5160 REM Imprimir el delimitador en color normal
5170 IF P <= L THEN PEN 1: PRINT C$; : P = P + 1: GOTO 5020
5180 RETURN

6000 REM --- 5. EDITAR CODIGO ---
6010 IF MAXL=0 THEN PRINT "No hay codigo!": FOR W=1 TO 500: NEXT W: RETURN
6020 FIL=1: BASE=1
6030 GOSUB 6300: REM Refrescar pantalla
6080 LOCATE 1, (FIL-BASE)+3: PRINT ">"
6090 IF INKEY(18)<>-1 OR INKEY(6)<>-1 THEN 6160
6095 IF INKEY(66)<>-1 THEN 6250 : REM ESC
6100 IF INKEY(0)<>-1 THEN 6130
6110 IF INKEY(2)<>-1 THEN 6140
6120 GOTO 6090
6130 LOCATE 1, (FIL-BASE)+3: PRINT " "
6132 FIL=FIL-1: IF FIL<1 THEN FIL=MAXL
6134 IF FIL < BASE OR FIL > BASE+19 THEN BASE=FIL: GOSUB 6300
6135 IF INKEY(0)<>-1 THEN 6135
6136 GOTO 6080
6140 LOCATE 1, (FIL-BASE)+3: PRINT " "
6142 FIL=FIL+1: IF FIL>MAXL THEN FIL=1
6144 IF FIL < BASE OR FIL > BASE+19 THEN BASE=FIL: GOSUB 6300
6145 IF INKEY(2)<>-1 THEN 6145
6146 GOTO 6080
6160 REM Editar linea seleccionada
6170 LOCATE 1, 23: PRINT "Editar L";FIL;" (Enter vacio = cancelar)"
6180 LOCATE 1, 24: PRINT STRING$(40, " ");
6190 LOCATE 1, 24: LINE INPUT NL$
6200 IF NL$<>"" THEN T$(FIL) = NL$: GOSUB 6300
6210 LOCATE 1, 23: PRINT STRING$(40, " ");: LOCATE 1, 24: PRINT STRING$(40, " ");
6220 GOTO 6080
6250 RETURN
6300 REM --- REFRESCO DE PANTALLA ---
6310 CLS: PRINT "--- EDITAR CODIGO (ESC SALIR) ---"
6320 FOR I=BASE TO BASE+19
6330 IF I<=MAXL THEN LOCATE 3, (I-BASE)+3: PRINT I;": "; LEFT$(T$(I),35)
6340 NEXT I
6350 RETURN
