1 BORDER 0:MODE 0
2 st=TIME/300
3 INK 0,0:INK 1,6:INK 2,2:INK 3,18:INK 4,24:INK 5,3:INK 6,1:INK 7,9:INK 8,12
4 ns%=4:DIM sx(ns%),sy(ns%),sz(ns%),sr(ns%),sc%(ns%),rs(ns%)
5 RESTORE 9000:FOR i%=1 TO ns%:READ sx(i%),sy(i%),sz(i%),sr(i%),sc%(i%):rs(i%)=SQR(sr(i%)):NEXT
6 lx=5:ly=5:lz=-5
10 FOR x%=0 TO 639 STEP 4
20 FOR y%=0 TO 399 STEP 2
30 ox=0:oy=0:oz=0
40 dx=(x%-320)/580:dy=(y%-200)/580:dz=1
50 dl=SQR(dx*dx+dy*dy+1):dx=dx/dl:dy=dy/dl:dz=dz/dl
60 GOSUB 1000
70 IF hit%=0 THEN col%=0:GOTO 300
80 hit1%=hit%:mt1=mt
90 px=ox+mt1*dx:py=oy+mt1*dy:pz=oz+mt1*dz
100 nx=(px-sx(hit1%))/rs(hit1%):ny=(py-sy(hit1%))/rs(hit1%):nz=(pz-sz(hit1%))/rs(hit1%)
130 ldx=lx-px:ldy=ly-py:ldz=lz-pz
140 llen=SQR(ldx*ldx+ldy*ldy+ldz*ldz)
150 ndotl=(nx*ldx+ny*ldy+nz*ldz)/llen
160 IF ndotl<0 THEN ndotl=0
170 ox=px+nx*0.02:oy=py+ny*0.02:oz=pz+nz*0.02
180 sdx=dx:sdy=dy:sdz=dz
190 dx=ldx/llen:dy=ldy/llen:dz=ldz/llen
200 GOSUB 1000
210 in_shadow=0:IF hit%>0 AND mt<llen THEN in_shadow=1
220 IF in_shadow=1 THEN ndotl=0
230 IF ndotl<0.2 THEN col%=hit1%+4 ELSE col%=hit1%
240 ndotd=sdx*nx+sdy*ny+sdz*nz
250 dx=sdx-2*ndotd*nx:dy=sdy-2*ndotd*ny:dz=sdz-2*ndotd*nz
260 GOSUB 1000
270 IF (x%\4+y%\2) MOD 2=0 THEN IF hit%>0 THEN col%=hit%+4 ELSE col%=0
300 PLOT x%,y%,col%
500 NEXT
505 et=(TIME/300)-st:LOCATE 1,1:PEN 5:PRINT USING "#####,.##s";et
510 NEXT
515 WHILE 1:WEND
520 STOP
1000 mt=1E+10:hit%=0
1020 FOR s%=1 TO ns%
1030 vx=ox-sx(s%):vy=oy-sy(s%):vz=oz-sz(s%)
1040 bh=dx*vx+dy*vy+dz*vz
1050 cq=vx*vx+vy*vy+vz*vz-sr(s%)
1060 dq=bh*bh-cq
1070 IF dq<0 THEN 1130
1080 dq=SQR(dq)
1090 t=-bh-dq
1100 IF t>0.01 AND t<mt THEN mt=t:hit%=s%
1110 t=-bh+dq
1120 IF t>0.01 AND t<mt THEN mt=t:hit%=s%
1130 NEXT
1140 RETURN
9000 DATA 0,-1,4,1,1
9001 DATA 2,0,4,1,2
9002 DATA -2,0,4,1,3
9003 DATA 0,-5001,0,25000000,4
