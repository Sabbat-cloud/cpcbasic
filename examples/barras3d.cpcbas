10 REM DIAGRAMA DE BARRAS
20 MODE 1
30 ORIGIN 10,25
40 LOCATE 3,25: PRINT " E F M A M J J A S O N D"
50 REM LECTURA DE DATOS
60 DIM X(12)
70 FOR K=1 TO 12
80 READ X(K)
90 IF X(K)>M THEN M=X(K)
100 NEXT K
110 REM ESCALA Y COLORES
115 ESCALA = 300/M
120 FOR K = 1 TO 12
140 X(K)=X(K)*ESCALA
150 FOR H=0 TO X(K)
160 PLOT 32*K,H
170 DRAWR 27,0,2:DRAWR 10,10,3
190 NEXT H
200 FOR V=1 TO 12
210 PLOT 32*K+V,X(K)+V
220 DRAWR 24,0,1
230 NEXT V
240 NEXT K
250 GOTO 250
999 REM DATOS DE CADA MES
1000 DATA 123,234,45,67,90,110,135,102,56,76,23,78
